DJANGO_SECRET_KEY=""
# Keep this True for local development. Setting it to False locally also
# switches on the HTTPS-only cookie and SSL redirect settings, which will
# break plain-HTTP access to the dev server.
DJANGO_DEBUG=True
# Comma-separated. On Render, set this to the hostname Render assigns.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://ucdtt:ucdtt@localhost:5432/ucdtt_rating
